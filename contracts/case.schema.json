{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babyradnik.local/contracts/case.schema.json",
  "title": "BabyRadnik — lista spraw testowych ZUS (fixtures/cases.json)",
  "description": "Sekcja 10. Rozpoznanie pliku: SHA-256 liczony w przeglądarce → id sprawy; zapas: nazwa pliku + liczba stron. Sam PDF nigdy nie trafia do repo ani na serwer.",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "tytul", "oczekiwanaDecyzja"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "tytul": { "type": "string", "description": "Opis sprawy z nazwy pliku." },
        "oczekiwanaDecyzja": { "enum": ["odmowa", "przyznanie", "do_odczytania"] },
        "persona": { "type": "string", "description": "Id osoby w symulatorze (z CASES_PRIVATE_DIR)." },
        "zgodnosc": { "enum": ["kwota", "okres", "decyzja"], "description": "Co w wyniku silnika sprawdzono z dokumentami ZUS: kwota (podstawa i stawka z wydruku ZUS), okres (okresy co do dnia), decyzja (odmowa potwierdzona)." },
        "plik": {
          "type": "object",
          "description": "Rozpoznanie dodanego PDF (GET /api/cases/by-hash/{sha256}; backend: CaseFile). Najpierw sha256; zapas: nazwa + liczbaStron (oba wymagane do dopasowania). Sam plik nie trafia do repo.",
          "additionalProperties": false,
          "properties": {
            "nazwa": { "type": "string", "maxLength": 260, "description": "Nazwa pliku PDF sprawy (porównanie bez rozróżniania wielkości liter)." },
            "liczbaStron": { "type": "integer", "minimum": 1, "description": "Liczba stron PDF (z pdf.js w przeglądarce)." },
            "sha256": {
              "type": "array",
              "uniqueItems": true,
              "description": "Sumy SHA-256 znanych wersji pliku (małe litery szesnastkowe).",
              "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "potwierdzoneOkresy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["swiadczenie", "od", "do", "dni"],
            "additionalProperties": false,
            "properties": {
              "swiadczenie": { "$ref": "assessment.schema.json#/$defs/benefitId" },
              "od": { "$ref": "assessment.schema.json#/$defs/data" },
              "do": { "$ref": "assessment.schema.json#/$defs/data" },
              "dni": { "type": "integer" },
              "tygodnie": { "type": "number" }
            }
          }
        }
      }
    },
    "CaseSummary": {
      "description": "Element odpowiedzi GET /api/cases i GET /api/cases/by-hash/{sha256}.",
      "type": "object",
      "required": ["id", "tytul", "oczekiwanaDecyzja", "dostepna"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "tytul": { "type": "string" },
        "oczekiwanaDecyzja": { "enum": ["odmowa", "przyznanie", "do_odczytania"] },
        "persona": { "type": ["string", "null"] },
        "zgodnosc": { "enum": ["kwota", "okres", "decyzja", null] },
        "dostepna": { "type": "boolean", "description": "false = dane osoby jeszcze nie dostarczone (do_uzupelnienia)." },
        "potwierdzoneOkresy": {
          "description": "Okresy świadczeń odczytane z akt sprawy ZUS; front porównuje je z okresami z silnika.",
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["swiadczenie", "od", "do"],
            "additionalProperties": false,
            "properties": {
              "swiadczenie": { "type": "string" },
              "od": { "type": "string", "format": "date" },
              "do": { "type": "string", "format": "date" },
              "dni": { "type": ["integer", "null"] },
              "tygodnie": { "type": ["integer", "null"] }
            }
          }
        }
      }
    }
  }
}
