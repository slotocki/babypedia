# Opcjonalne. Skopiuj do .env i uzupełnij, jeśli chcesz zmienić wartości domyślne.
# Plik .env jest w .gitignore — nigdy go nie commituj.
# Docker Compose czyta .env sam; `dotnet run` go NIE czyta — tam ustaw zmienne w powłoce
# (np. ADMIN_PASSWORD=demo dotnet run --project api/Api).

# Panel /admin (nagłówek X-Admin-Password). Puste = panel wyłączony.
ADMIN_PASSWORD=

# PostgreSQL w kontenerze. Puste = domyślne hasło babyradnik. Po zmianie hasła przy istniejącej bazie
# usuń lokalny wolumen bazy, bo PostgreSQL zachowuje hasło z pierwszego startu.
POSTGRES_PASSWORD=
# Tylko dla `dotnet run` z własnym PostgreSQL (Docker Compose podaje własny connection string).
# Brak tej zmiennej albo pusta wartość = baza w pamięci (EF Core InMemory); zmiany z /admin giną po restarcie.
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=babyradnik;Username=babyradnik;Password=

# Katalog z prywatnymi danymi spraw ZUS (cases.json, personas/*.json) — POZA repozytorium.
# Ścieżka na hoście; w kontenerze montowana tylko do odczytu jako /cases. Puste = lista spraw pusta.
CASES_PRIVATE_DIR=

# Porty i adres publiczny
API_PORT=5080
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Profil `proxy` (HTTPS przez Caddy): domena wskazująca na serwer
DOMAIN=

# Czat: FAQ i wyszukiwarka działają zawsze, bez klucza. Model jest opcjonalny.
# Dostawcy modelu: openai, anthropic, opencode, opencode-go. Claude Haiku: ASSISTANT_ENABLED=true,
# ASSISTANT_PROVIDER=anthropic i ANTHROPIC_API_KEY.
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=openai
ASSISTANT_BASE_URL=http://assistant:11434/v1
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=250
ANTHROPIC_API_KEY=
# DeepSeek przez OpenCode Go. Włączenie ma pierwszeństwo przed ASSISTANT_PROVIDER.
# Używaj OPENCODE_ENABLED. Starsza, błędnie zapisana PENCODE_ENABLED jest nadal czytana (zgodność wsteczna), gdy OPENCODE_ENABLED jest puste.
OPENCODE_ENABLED=false
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
