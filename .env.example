# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore — nigdy go nie commituj.

# Panel /admin (nagłówek X-Admin-Password). Puste = panel wyłączony.
ADMIN_PASSWORD=

# PostgreSQL w kontenerze
POSTGRES_PASSWORD=
# Dla `dotnet run` poza Dockerem (składnia ASP.NET Core):
ConnectionStrings__Default=Host=localhost;Port=5432;Database=babyradnik;Username=babyradnik;Password=

# Katalog z prywatnymi danymi spraw ZUS (personas/*.json przepisane z dokumentów) — POZA repozytorium (sekcja 14).
# Ścieżka na hoście; w kontenerze montowana tylko do odczytu jako /cases.
CASES_PRIVATE_DIR=

# Porty i adres publiczny
API_PORT=5080
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Profil `proxy` (HTTPS przez Caddy): domena wskazująca na serwer
DOMAIN=

# Opcjonalny pomocnik tekstowy (P2): endpoint zgodny z OpenAI (Ollama / llama.cpp). Bez danych osoby, bez kwot.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=http://assistant:11434/v1
ASSISTANT_MODEL=
